# Neon: Console > your project > Connect. Use the pooled string for DATABASE_URL and the direct (non-pooled) string for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Launch switch: while COMING_SOON=true everyone sees /coming-soon. Open /?preview=<PREVIEW_SECRET> once to unlock the real site in your browser.
COMING_SOON=true
PREVIEW_SECRET=choose-a-long-random-string
# Set the public canonical origin (for example, your verified production domain).
NEXT_PUBLIC_SITE_URL=
# Long random server-only secret used to HMAC-hash public form rate-limit keys.
RATE_LIMIT_SALT=
# Private dream intake stays closed until AILU completes its legal and safeguarding review.
DREAMS_FORM_OPEN=false
# Optional (digits only, e.g. 918296793486). Defaults to lib/brand.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Admin system (phase A0) ----
# Random signing secret for staff sessions: e.g. run `openssl rand -base64 32`.
AUTH_SECRET=
# Staff sign in with email and password. Set the first owner password with: npm run staff:password -- owner@example.com
# Google sign-in is off for now. Set AUTH_GOOGLE_ENABLED=true with the two values below to bring it back.
AUTH_GOOGLE_ENABLED=false
# Google OAuth staff sign-in (see CRM_CMS_PLAN.md). Redirect URIs: http://localhost:3000/api/auth/callback/google and <prod url>.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# This address may become OWNER only while StaffUser is empty.
ADMIN_BOOTSTRAP_EMAIL=
